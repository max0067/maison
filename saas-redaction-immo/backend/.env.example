# Configuration base de données MySQL
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/database_name

# Clés API IA
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
